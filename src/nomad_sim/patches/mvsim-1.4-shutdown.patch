+## Local NOMAD compatibility patch (2026-09-29)
+
+ROS 2 shutdown is performed after `rclcpp::spin()` returns and its timer is cancelled, not inside the asynchronous shutdown callback. `terminateSimulation()` joins both the node GUI updater and the World-owned renderer before draining publisher workers and releasing the World. This prevents observation enqueue after the worker pool stops, and concurrent timer access during teardown. The source base remains upstream tag 1.4.0; the local diff is recorded in the sibling `nomad_sim/patches/` directory.
diff --git a/mvsim_node_src/mvsim_node.cpp b/mvsim_node_src/mvsim_node.cpp
index 9c19ebe..5424b6b 100644
--- a/mvsim_node_src/mvsim_node.cpp
+++ b/mvsim_node_src/mvsim_node.cpp
@@ -332,9 +332,13 @@ void MVSimNode::terminateSimulation()
 		thGUI_.join();
 	}
 
-	mvsim_world_->free_opengl_resources();
-
+	// Stop the World-owned renderer before draining observation publishers.
+	if (mvsim_world_->gui_thread_.joinable())
+	{
+		mvsim_world_->gui_thread_.join();
+	}
 	ros_publisher_workers_.clear();
+	mvsim_world_->free_opengl_resources();
 	// Don't destroy mvsim_server_ yet, since "world" needs to unregister.
 	mvsim_world_.reset();
 	std::cout << "[MVSimNode::terminateSimulation] All done." << std::endl;
