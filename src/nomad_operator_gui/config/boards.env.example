# PC SSH settings for the deployed native Humble board runtimes.
# Copy to ~/.config/nomad/boards.env and adjust paths for your installation.
NOMAD_PI5_HOST=user-desktop.local
NOMAD_PI5_USER=user
NOMAD_PI5_SCRIPT=/home/user/nomad_gnss_pi5/scripts/run_pi5_autonomy_local.sh
NOMAD_PI4_HOST=lpp.local
NOMAD_PI4_USER=user
NOMAD_PI4_SCRIPT=/home/user/nomad_link_ws/scripts/run_pi4_autonomy.sh
NOMAD_JETSON_HOST=ubuntu.local
NOMAD_JETSON_USER=nvidia
NOMAD_JETSON_SCRIPT=/home/nvidia/nomad_semantic_20261030/scripts/run_jetson_autonomy_local.sh
NOMAD_SSH_KEY="$HOME/.ssh/nomad_operator_ed25519"
