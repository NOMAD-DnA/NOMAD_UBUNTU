          <horizontal_fov>1.27409035395586</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>L8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>40</far>
          </clip>
          <lens>
            <type>gnomonical</type>
            <intrinsics>
              <fx>432.455180142659</fx>
              <fy>432.971461265142</fy>
              <cx>320</cx>
              <cy>240</cy>
              <s>0</s>
            </intrinsics>
            <projection>
              <p_fx>432.455180142659</p_fx>
              <p_fy>432.971461265142</p_fy>
              <p_cx>320</p_cx>
              <p_cy>240</p_cy>
              <tx>-32.4341385106994</tx>
              <ty>0</ty>
            </projection>
          </lens>
        </camera>
      </sensor>
      <sensor name="ydlidar_g2" type="gpu_lidar">
        <pose relative_to="base_link">0.15 0 0.38 0 0 0</pose>
        <topic>/nomad/raw/scan</topic>
        <gz_frame_id>scan</gz_frame_id>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <visualize>false</visualize>
        <lidar>
          <scan>
            <horizontal>
              <samples>500</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159265358979</min_angle>
              <max_angle>3.12902628297543</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.12</min>
            <max>12</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0</mean>
            <stddev>0.01</stddev>
          </noise>
        </lidar>
      </sensor>
      <sensor name="oak_imu" type="imu">
        <pose relative_to="base_link">0.46 0 0.29 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>200</update_rate>
        <topic>/nomad/raw/oak/imu</topic>
        <gz_frame_id>oak_imu_frame</gz_frame_id>
        <imu />
      </sensor>
    </link>
