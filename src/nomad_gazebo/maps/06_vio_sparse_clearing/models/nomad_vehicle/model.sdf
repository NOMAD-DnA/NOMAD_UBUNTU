    <frame name="oak_rgb_optical_frame" attached_to="base_link">
      <pose relative_to="base_link">0.46 0 0.29 -1.5707963267949 0 -1.5707963267949</pose>
    </frame>
    <frame name="oak_depth_optical_frame" attached_to="base_link">
      <pose relative_to="base_link">0.46 0 0.29 -1.5707963267949 0 -1.5707963267949</pose>
    </frame>
    <frame name="oak_left_optical_frame" attached_to="base_link">
