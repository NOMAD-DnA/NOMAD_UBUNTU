<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.10">
  <model name="nomad_vehicle" canonical_link="base_link">
    <!--PROVISIONAL dimensions/masses, no suspension; NOT calibrated motor output.-->
    <static>false</static>
    <self_collide>false</self_collide>
    <link name="base_link">
      <pose relative_to="__model__">0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0 0.2 0 0 0</pose>
        <mass>30</mass>
        <inertia>
          <ixx>0.661</ixx>
          <iyy>1.84225</iyy>
          <izz>2.43125</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="base_link_visual">
        <pose>0 0 0.2 0 0 0</pose>
        <geometry>
          <box>
            <size>0.85 0.5 0.12</size>
          </box>
        </geometry>
        <material>
          <ambient>0.15 0.38 0.18 1</ambient>
          <diffuse>0.15 0.38 0.18 1</diffuse>
        </material>
      </visual>
      <collision name="base_link_collision">
        <pose>0 0 0.2 0 0 0</pose>
        <geometry>
          <box>
            <size>0.85 0.5 0.12</size>
          </box>
        </geometry>
      </collision>
      <sensor name="oak_rgb" type="rgbd_camera">
        <pose relative_to="base_link">0.46 0 0.29 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <visualize>false</visualize>
        <topic>/nomad/raw/oak/rgbd</topic>
        <gz_frame_id>oak_rgb_optical_frame</gz_frame_id>
        <camera>
          <optical_frame_id>oak_rgb_optical_frame</optical_frame_id>
          <horizontal_fov>1.20427718387609</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>40</far>
          </clip>
          <depth_camera>
            <clip>
              <near>0.4</near>
              <far>8</far>
            </clip>
          </depth_camera>
          <lens>
            <type>gnomonical</type>
            <intrinsics>
              <fx>465.602889175182</fx>
              <fy>471.026521321236</fy>
              <cx>320</cx>
              <cy>240</cy>
              <s>0</s>
            </intrinsics>
            <projection>
              <p_fx>465.602889175182</p_fx>
              <p_fy>471.026521321236</p_fy>
              <p_cx>320</p_cx>
              <p_cy>240</p_cy>
              <tx>0</tx>
              <ty>0</ty>
            </projection>
          </lens>
        </camera>
      </sensor>
      <sensor name="oak_left" type="camera">
        <pose relative_to="base_link">0.46 0.0375 0.29 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <visualize>false</visualize>
        <topic>/nomad/raw/oak/left/image_raw</topic>
        <gz_frame_id>oak_left_optical_frame</gz_frame_id>
        <camera>
          <optical_frame_id>oak_left_optical_frame</optical_frame_id>
          <camera_info_topic>/nomad/raw/oak/left/camera_info</camera_info_topic>
          <horizontal_fov>1.27409035395586</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>L8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>40</far>
          </clip>
          <lens>
            <type>gnomonical</type>
            <intrinsics>
              <fx>432.455180142659</fx>
              <fy>432.971461265142</fy>
              <cx>320</cx>
              <cy>240</cy>
              <s>0</s>
            </intrinsics>
            <projection>
              <p_fx>432.455180142659</p_fx>
              <p_fy>432.971461265142</p_fy>
              <p_cx>320</p_cx>
              <p_cy>240</p_cy>
              <tx>0</tx>
              <ty>0</ty>
            </projection>
          </lens>
        </camera>
      </sensor>
      <sensor name="oak_right" type="camera">
        <pose relative_to="base_link">0.46 -0.0375 0.29 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <visualize>false</visualize>
        <topic>/nomad/raw/oak/right/image_raw</topic>
        <gz_frame_id>oak_right_optical_frame</gz_frame_id>
