find_package(ament_cmake REQUIRED)
find_package(rclcpp REQUIRED)
find_package(sensor_msgs REQUIRED)
find_package(nav_msgs REQUIRED)
find_package(std_msgs REQUIRED)
find_package(diagnostic_msgs REQUIRED)
find_package(tf2_ros REQUIRED)
find_package(nomad_interfaces REQUIRED)
find_package(OpenSSL REQUIRED)
include(${CMAKE_CURRENT_LIST_DIR}/native_ros_targets.cmake)
add_library(nomad_runtime src/runtime.cpp src/snapshot_writer.cpp)
target_link_libraries(nomad_runtime PUBLIC nomad_costmap_core OpenSSL::Crypto)
target_compile_options(nomad_runtime PRIVATE -Wall -Wextra -Wpedantic)
add_executable(nomad_mapper src/mapper_main.cpp src/mapper.cpp src/receivers.cpp)
target_link_libraries(nomad_mapper PRIVATE nomad_runtime ${NOMAD_ROS_TARGETS})
add_executable(nomad_monitor src/monitor.cpp)
target_link_libraries(nomad_monitor PRIVATE nomad_runtime ${NOMAD_ROS_TARGETS})
add_executable(nomad_runtime_manager src/manager.cpp)
target_link_libraries(nomad_runtime_manager PRIVATE nomad_runtime)
add_executable(nomad_runtime_test tests/runtime_test.cpp)
target_link_libraries(nomad_runtime_test PRIVATE nomad_runtime)
target_compile_options(nomad_runtime_test PRIVATE -UNDEBUG)
add_test(NAME native_runtime COMMAND nomad_runtime_test)
add_executable(nomad_ros_contract_test tests/ros_contract_test.cpp)
target_link_libraries(nomad_ros_contract_test PRIVATE nomad_runtime ${NOMAD_ROS_TARGETS})
target_compile_options(nomad_ros_contract_test PRIVATE -O0)
add_test(NAME native_ros_contract COMMAND nomad_ros_contract_test)
set_tests_properties(native_ros_contract PROPERTIES ENVIRONMENT "ROS_DOMAIN_ID=214")
add_executable(nomad_event_dispatch_test tests/event_dispatch_test.cpp)
target_link_libraries(nomad_event_dispatch_test PRIVATE nomad_runtime ${NOMAD_ROS_TARGETS})
target_compile_options(nomad_event_dispatch_test PRIVATE -O0 -UNDEBUG)
add_test(NAME native_event_dispatch COMMAND nomad_event_dispatch_test)
set_tests_properties(native_event_dispatch PROPERTIES ENVIRONMENT "ROS_DOMAIN_ID=218" TIMEOUT 20)
install(TARGETS nomad_mapper nomad_monitor nomad_runtime_manager DESTINATION lib/nomad_costmap_cpp)
