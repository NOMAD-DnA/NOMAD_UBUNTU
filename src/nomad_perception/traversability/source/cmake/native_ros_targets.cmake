# The pinned Focal/Humble underlay exports every message binding, including
# generator_py, through some C++ targets. Those bindings are unused by native
# rclcpp code. Prune them from this build's imported target closure only;
# the installed ROS underlay is never edited. ELF dependencies are audited too.
function(nomad_native_closure target)
  if(NOT TARGET "${target}")
    return()
  endif()
  get_property(visited GLOBAL PROPERTY NOMAD_NATIVE_VISITED)
  if("${target}" IN_LIST visited)
    return()
  endif()
  set_property(GLOBAL APPEND PROPERTY NOMAD_NATIVE_VISITED "${target}")
  get_target_property(links "${target}" INTERFACE_LINK_LIBRARIES)
  if(NOT links)
    return()
  endif()
  set(native_links)
  foreach(link IN LISTS links)
    if(link MATCHES "__rosidl_generator_py|Python[23]?::|libpython|python[23]\\.[0-9]+")
      message(STATUS "Native ROS closure excludes unused Python binding: ${target} -> ${link}")
      continue()
    endif()
    list(APPEND native_links "${link}")
    if(link MATCHES "^\\$<LINK_ONLY:(.*)>$")
      nomad_native_closure("${CMAKE_MATCH_1}")
    else()
      nomad_native_closure("${link}")
    endif()
  endforeach()
  set_property(TARGET "${target}" PROPERTY INTERFACE_LINK_LIBRARIES "${native_links}")
endfunction()
set(NOMAD_ROS_TARGETS rclcpp::rclcpp tf2_ros::tf2_ros)
foreach(package sensor_msgs nav_msgs std_msgs diagnostic_msgs nomad_interfaces)
  list(APPEND NOMAD_ROS_TARGETS
    "${package}::${package}__rosidl_generator_cpp"
    "${package}::${package}__rosidl_typesupport_cpp")
endforeach()
foreach(target IN LISTS NOMAD_ROS_TARGETS)
  if(NOT TARGET "${target}")
    message(FATAL_ERROR "Required native ROS target is unavailable: ${target}")
  endif()
  nomad_native_closure("${target}")
endforeach()
