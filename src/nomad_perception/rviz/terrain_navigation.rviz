Panels:
- Class: rviz_common/Displays
  Name: Displays
Visualization Manager:
  Class: ''
  Global Options:
    Fixed Frame: odom
    Background Color: 35; 35; 35
    Frame Rate: 20
  Displays:
  - Class: rviz_default_plugins/Pose
    Name: Final goal - MAGENTA
    Enabled: true
    Topic:
      Value: /nomad/goal
      Durability Policy: Transient Local
      Reliability Policy: Reliable
      History Policy: Keep Last
      Depth: 1
    Shape: Arrow
    Color: 255; 0; 255
    Alpha: 1
    Shaft Length: 1.2
    Shaft Radius: 0.09
    Head Length: 0.35
    Head Radius: 0.2
  - Class: rviz_default_plugins/Pose
    Name: Intermediate waypoint - ORANGE
    Enabled: true
    Topic:
      Value: /nomad/navigation_target
      Durability Policy: Transient Local
      Reliability Policy: Reliable
      History Policy: Keep Last
      Depth: 1
    Shape: Arrow
    Color: 255; 145; 0
    Alpha: 1
    Shaft Length: 0.7
    Shaft Radius: 0.09
    Head Length: 0.35
    Head Radius: 0.2
  - Class: rviz_default_plugins/RobotModel
    Name: Vehicle
    Enabled: true
    Description Source: Topic
    Description Topic:
      Value: /robot_description
      Durability Policy: Transient Local
      Reliability Policy: Reliable
    Visual Enabled: true
    Collision Enabled: false
    Alpha: 1
  - Class: rviz_default_plugins/Axes
    Name: Vehicle position and heading
    Enabled: true
    Reference Frame: base_link
    Length: 1
    Radius: 0.06
  - Class: rviz_default_plugins/Grid
    Name: Grid
    Enabled: true
    Cell Size: 1
  - Class: rviz_default_plugins/Map
    Name: Observed RGB-D terrain
    Enabled: false
    Topic:
      Value: /nomad/terrain/grid
      Durability Policy: Transient Local
      Reliability Policy: Reliable
    Alpha: 1.0
  - Class: rviz_default_plugins/Map
    Name: Global semantic + slope cost
    Enabled: false
    Topic:
      Value: /nomad/navigation_costmap
      Durability Policy: Transient Local
      Reliability Policy: Reliable
    Color Scheme: costmap
    Alpha: 1.0
  - Class: rviz_default_plugins/Map
    Name: Local drivable clearance
    Enabled: true
    Topic:
      Value: /nomad/navigation_local_costmap
      Durability Policy: Transient Local
      Reliability Policy: Reliable
    Alpha: 1.0
    Color Scheme: costmap
  - Class: rviz_default_plugins/Image
    Name: Camera terrain labels
    Enabled: false
    Topic:
      Value: /nomad/terrain_labels
      Reliability Policy: Reliable
  - Class: rviz_default_plugins/Path
    Name: GPP
    Enabled: true
    Topic:
      Value: /nomad/global_path
    Color: 0; 180; 255
    Line Width: 0.12
    Line Style: Billboards
  - Class: rviz_default_plugins/Path
    Name: LPP and reverse
    Enabled: true
    Topic:
      Value: /nomad/local_path
    Color: 255; 210; 0
    Line Width: 0.1
  - Class: rviz_default_plugins/LaserScan
    Name: LiDAR
    Enabled: true
    Topic:
      Value: /scan
      Reliability Policy: Best Effort
    Size (m): 0.04
  - Class: rviz_common/Group
    Name: GPP COST COLORS - Green LOW / Red HIGH
    Enabled: false
    Displays:
    - Class: rviz_default_plugins/PointCloud2
      Name: total (0-160; green=low, red=high)
      Enabled: true
      Topic:
        Value: /nomad/gpp_cost/total_color
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Alpha: 1.0
      Style: Flat Squares
      Size (m): 0.2
      Color Transformer: RGB8
      Position Transformer: XYZ
      Queue Size: 1
      Decay Time: 0.0
    - Class: rviz_default_plugins/PointCloud2
      Name: slope (0-10; green=low, red=high)
      Enabled: false
      Topic:
        Value: /nomad/gpp_cost/slope_color
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Alpha: 1.0
      Style: Flat Squares
      Size (m): 0.2
      Color Transformer: RGB8
      Position Transformer: XYZ
      Queue Size: 1
      Decay Time: 0.0
    - Class: rviz_default_plugins/PointCloud2
      Name: proximity (0-32; green=low, red=high)
      Enabled: false
      Topic:
        Value: /nomad/gpp_cost/proximity_color
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Alpha: 1.0
      Style: Flat Squares
      Size (m): 0.2
      Color Transformer: RGB8
      Position Transformer: XYZ
      Queue Size: 1
      Decay Time: 0.0
    - Class: rviz_default_plugins/PointCloud2
      Name: cluster (0-64; green=low, red=high)
      Enabled: false
      Topic:
        Value: /nomad/gpp_cost/cluster_color
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Alpha: 1.0
      Style: Flat Squares
      Size (m): 0.2
      Color Transformer: RGB8
      Position Transformer: XYZ
      Queue Size: 1
      Decay Time: 0.0
    - Class: rviz_default_plugins/PointCloud2
      Name: observation (0-80; green=low, red=high)
      Enabled: false
      Topic:
        Value: /nomad/gpp_cost/observation_color
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Alpha: 1.0
      Style: Flat Squares
      Size (m): 0.2
      Color Transformer: RGB8
      Position Transformer: XYZ
      Queue Size: 1
      Decay Time: 0.0
    - Class: rviz_default_plugins/PointCloud2
      Name: terrain (0-1; green=low, red=high)
      Enabled: false
      Topic:
        Value: /nomad/gpp_cost/terrain_color
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Alpha: 1.0
      Style: Flat Squares
      Size (m): 0.2
      Color Transformer: RGB8
      Position Transformer: XYZ
      Queue Size: 1
      Decay Time: 0.0
    - Class: rviz_default_plugins/PointCloud2
      Name: unknown_direction (0-8; green=low, red=high)
      Enabled: false
      Topic:
        Value: /nomad/gpp_cost/unknown_direction_color
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Alpha: 1.0
      Style: Flat Squares
      Size (m): 0.2
      Color Transformer: RGB8
      Position Transformer: XYZ
      Queue Size: 1
      Decay Time: 0.0
    - Class: rviz_default_plugins/Image
      Name: Cost color legend
      Enabled: true
      Topic:
        Value: /nomad/gpp_cost/legend
        Durability Policy: Transient Local
        Reliability Policy: Reliable
  Tools:
  - Class: rviz_default_plugins/Interact
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/SetGoal
    Topic:
      Value: /goal_pose
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Target Frame: base_link
      Scale: 25
      X: 0
      Y: 0
Window Geometry:
  Width: 1200
  Height: 800
