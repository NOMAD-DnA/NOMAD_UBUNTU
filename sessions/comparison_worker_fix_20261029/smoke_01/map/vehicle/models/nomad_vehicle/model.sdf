<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.10">
  <model name="nomad_vehicle" canonical_link="base_link">
    <!--PROVISIONAL dimensions/masses, no suspension; NOT calibrated motor output.-->
    <static>false</static>
    <self_collide>false</self_collide>
    <link name="base_link">
      <pose relative_to="__model__">0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0 0.2 0 0 0</pose>
        <mass>30</mass>
        <inertia>
          <ixx>0.661</ixx>
          <iyy>1.84225</iyy>
          <izz>2.43125</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
