    <joint name="front_left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>front_left_wheel</child>
      <pose relative_to="front_left_wheel">0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
          <effort>20</effort>
          <velocity>20</velocity>
        </limit>
        <dynamics>
          <damping>0.02</damping>
        </dynamics>
      </axis>
    </joint>
    <joint name="front_right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>front_right_wheel</child>
      <pose relative_to="front_right_wheel">0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
          <effort>20</effort>
          <velocity>20</velocity>
        </limit>
        <dynamics>
          <damping>0.02</damping>
        </dynamics>
      </axis>
    </joint>
    <joint name="rear_left_steering_joint" type="revolute">
      <parent>base_link</parent>
      <child>rear_left_steering_link</child>
      <pose relative_to="rear_left_steering_link">0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-0.55</lower>
          <upper>0.55</upper>
          <effort>12</effort>
          <velocity>2</velocity>
        </limit>
        <dynamics>
          <damping>0.02</damping>
        </dynamics>
      </axis>
    </joint>
    <joint name="rear_left_wheel_joint" type="revolute">
      <parent>rear_left_steering_link</parent>
      <child>rear_left_wheel</child>
      <pose relative_to="rear_left_wheel">0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
          <effort>20</effort>
          <velocity>20</velocity>
        </limit>
        <dynamics>
          <damping>0.02</damping>
        </dynamics>
      </axis>
    </joint>
    <joint name="rear_right_steering_joint" type="revolute">
      <parent>base_link</parent>
      <child>rear_right_steering_link</child>
      <pose relative_to="rear_right_steering_link">0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 0 1</xyz>
