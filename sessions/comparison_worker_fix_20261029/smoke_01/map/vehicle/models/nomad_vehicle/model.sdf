      <child>rear_right_wheel</child>
      <pose relative_to="rear_right_wheel">0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
          <effort>20</effort>
          <velocity>20</velocity>
        </limit>
        <dynamics>
          <damping>0.02</damping>
        </dynamics>
      </axis>
    </joint>
    <frame name="oak_rgb_optical_frame" attached_to="base_link">
      <pose relative_to="base_link">0.46 0 0.29 -1.5707963267949 0 -1.5707963267949</pose>
    </frame>
    <frame name="oak_depth_optical_frame" attached_to="base_link">
      <pose relative_to="base_link">0.46 0 0.29 -1.5707963267949 0 -1.5707963267949</pose>
    </frame>
    <frame name="oak_left_optical_frame" attached_to="base_link">
      <pose relative_to="base_link">0.46 0.06 0.29 -1.5707963267949 0 -1.5707963267949</pose>
    </frame>
    <frame name="oak_right_optical_frame" attached_to="base_link">
      <pose relative_to="base_link">0.46 -0.06 0.29 -1.5707963267949 0 -1.5707963267949</pose>
    </frame>
    <frame name="scan" attached_to="base_link">
      <pose relative_to="base_link">0.15 0 0.38 0 0 0</pose>
    </frame>
    <frame name="oak_imu_frame" attached_to="base_link">
      <pose relative_to="base_link">0.46 0 0.29 0 0 0</pose>
    </frame>
    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>front_left_wheel_joint</joint_name>
      <topic>/nomad/rear_steer/actuators/front_left_velocity</topic>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>rear_left_steering_joint</joint_name>
      <topic>/nomad/rear_steer/actuators/rear_left_position</topic>
      <use_velocity_commands>true</use_velocity_commands>
      <p_gain>8</p_gain>
      <cmd_max>1</cmd_max>
      <cmd_min>-1</cmd_min>
    </plugin>
    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>front_right_wheel_joint</joint_name>
      <topic>/nomad/rear_steer/actuators/front_right_velocity</topic>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>rear_right_steering_joint</joint_name>
      <topic>/nomad/rear_steer/actuators/rear_right_position</topic>
      <use_velocity_commands>true</use_velocity_commands>
      <p_gain>8</p_gain>
      <cmd_max>1</cmd_max>
      <cmd_min>-1</cmd_min>
    </plugin>
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <dimensions>3</dimensions>
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <odom_topic>/nomad/vehicle/odom</odom_topic>
      <tf_topic>/nomad/vehicle/tf</tf_topic>
      <odom_publish_frequency>50</odom_publish_frequency>
      <gaussian_noise>0</gaussian_noise>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/nomad/vehicle/joint_states</topic>
      <update_rate>50</update_rate>
      <joint_name>front_left_wheel_joint</joint_name>
      <joint_name>front_right_wheel_joint</joint_name>
      <joint_name>rear_left_steering_joint</joint_name>
      <joint_name>rear_left_wheel_joint</joint_name>
      <joint_name>rear_right_steering_joint</joint_name>
      <joint_name>rear_right_wheel_joint</joint_name>
    </plugin>
  </model>
</sdf>
